#: orders/admin.py:177
msgid "Cannot modify items from shipped or delivered orders."
msgstr "Հնարավոր չէ փոփոխել առաքված կամ առաքված պատվերների տարրերը։"

#: orders/admin.py:182
msgid "Cannot update the item due to insufficient stock."
msgstr "Հնարավոր չէ թարմացնել տարրը՝ պահեստում բավարար քանակի բացակայության պատճառով։"

#: orders/admin.py:192 orders/admin.py:202
