#: orders/admin.py:156
msgid ""
"Price does not match the current product price. Please update the product's "
"price."
msgstr "Գինը չի համընկնում ընթացիկ ապրանքի գնի հետ։ Խնդրում ենք թարմացնել ապրանքի գինը։"

#: orders/admin.py:160
msgid "Insufficient stock for the requested quantity."
